@dc:title "My Project Description Bundle"
@dc:description "A bundle that includes the description for the University Course Registration and Degree Planning project."
description bundle <http://www.example.com/project/bundle#> as myproject-bundle {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/bundle#>
    includes <http://www.example.com/project/description#>
}